@{
}

@model List<Technical_Exam.Domain.Entities.Position>
<div>
    <h1>Positions<a class="btn btn-primary ms-3" asp-controller="Positions" asp-action="Add">Create</a></h1>
</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Department</th>
            <th>Location</th>
            <th>Job</th>
            <th>Type</th>
            <th>Status</th>
            <th>Employee Assigned</th>
            <th>Created By</th>
            <th>Time Created</th>
            <th>Updated By</th>
            <th>Last Updated</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var position in Model)
        {
            <tr>
                <td>@position.PositionId</td>
                <td>@position.PositionName</td>
                <td>@position.DepartmentId</td>
                <td>@position.LocationId</td>
                <td>@position.JobId</td>
                <td>@position.EmploymentType</td>
                <td>@position.EmploymentStatus</td>
                <td>@position.EmployeeId</td>
                <td>@position.CreatedById</td>
                <td>@position.TimeCreated</td>
                <td>@position.UpdatedById</td>
                <td>@position.LastUpdated</td>
                <td>
                    <a class="btn btn-primary" asp-controller="Positions" asp-action="Edit" asp-route-id="@position.PositionId">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>