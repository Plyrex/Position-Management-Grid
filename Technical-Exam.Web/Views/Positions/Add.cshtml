@{
}

@model Technical_Exam.Infrastructure.Models.CreatePositionViewModel

<h1>Create Position</h1>

<form method="post">
    <div class="mt-3">
        <label class="form-label">Position Name</label>
        <input type="text" class="form-control" asp-for="PositionName"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Department ID</label>
        <input type="text" class="form-control" asp-for="DepartmentId"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Location ID</label>
        <input type="text" class="form-control" asp-for="LocationId"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Job ID</label>
        <input type="text" class="form-control" asp-for="JobId"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Employment Type</label>
        <input type="text" class="form-control" asp-for="EmploymentType"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Employment Status</label>
        <input type="text" class="form-control" asp-for="EmploymentStatus"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Employee ID</label>
        <input type="text" class="form-control" asp-for="EmployeeId"/>
    </div>

    <div class="mt-3">
        <label class="form-label">Created By: ID</label>
        <input type="text" class="form-control" asp-for="CreatedById"/>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>
